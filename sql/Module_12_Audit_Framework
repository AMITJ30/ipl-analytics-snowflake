USE DATABASE IPL_ANALYTICS;
CREATE SCHEMA IF NOT EXISTS UTIL;
USE SCHEMA UTIL;

CREATE SEQUENCE IF NOT EXISTS LOAD_AUDIT_SEQ START=1 INCREMENT=1;

CREATE TABLE IF NOT EXISTS LOAD_AUDIT
(
    AUDIT_ID NUMBER DEFAULT LOAD_AUDIT_SEQ.NEXTVAL,
    PIPELINE_NAME STRING,
    TABLE_NAME STRING,
    FILE_NAME STRING,
    BATCH_ID STRING,
    LOAD_START_TIME TIMESTAMP_NTZ,
    LOAD_END_TIME TIMESTAMP_NTZ,
    ROWS_LOADED NUMBER,
    LOAD_STATUS STRING,
    ERROR_MESSAGE STRING,
    CREATED_BY STRING DEFAULT CURRENT_USER(),
    CREATED_TS TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
);

CREATE TABLE IF NOT EXISTS ERROR_LOG
(
    ERROR_ID NUMBER AUTOINCREMENT,
    PIPELINE_NAME STRING,
    OBJECT_NAME STRING,
    ERROR_MESSAGE STRING,
    ERROR_TS TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP(),
    CREATED_BY STRING DEFAULT CURRENT_USER()
);

CREATE TABLE IF NOT EXISTS PIPELINE_RUN
(
    RUN_ID NUMBER AUTOINCREMENT,
    PIPELINE_NAME STRING,
    BATCH_ID STRING,
    RUN_STATUS STRING,
    START_TIME TIMESTAMP_NTZ,
    END_TIME TIMESTAMP_NTZ,
    CREATED_TS TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP()
);

SHOW TABLES IN SCHEMA UTIL;

SELECT 'LOAD_AUDIT' TABLE_NAME, COUNT(*) ROWS FROM LOAD_AUDIT
UNION ALL
SELECT 'ERROR_LOG', COUNT(*) FROM ERROR_LOG
UNION ALL
SELECT 'PIPELINE_RUN', COUNT(*) FROM PIPELINE_RUN;
